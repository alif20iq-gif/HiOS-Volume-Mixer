<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HiOSVolumeMixer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4F7CFF</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.HiOSVolumeMixer.Popup" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">#FFF7F7FA</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
    <style name="Theme.HiOSVolumeMixer.SettingsDialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:windowBackground">#FFF7F7FA</item>
        <item name="android:textColorPrimary">#FF24232A</item>
        <item name="android:textColorSecondary">#FF625E69</item>
        <item name="colorSurface">#FFF7F7FA</item>
        <item name="colorOnSurface">#FF24232A</item>
        <item name="colorOnSurfaceVariant">#FF625E69</item>
        <item name="colorPrimary">#FF4F68B5</item>
        <item name="android:colorAccent">#FF4F68B5</item>
    </style>
</resources>